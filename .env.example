PORT=3000

# Create any secret text here, then enter the same text in Meta webhook verification.
VERIFY_TOKEN=change-this-verify-token

# WhatsApp Cloud API values from Meta Developer dashboard.
WHATSAPP_TOKEN=your-permanent-or-temporary-access-token
PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# Password to log into the admin dashboard at /admin. Change this before deploying.
ADMIN_PASSWORD=change-this-admin-password

# Optional: powers the dashboard's Marketing tab (live Meta Ads spend/leads/results).
# META_ACCESS_TOKEN: Meta Business Settings > System Users > generate a token with "ads_read"
#   permission on your ad account.
# META_AD_ACCOUNT_ID: your ad account's numeric ID (without the "act_" prefix).
# Leave both unset if you don't want the Marketing tab.
META_ACCESS_TOKEN=your-meta-ads-read-access-token
META_AD_ACCOUNT_ID=your-ad-account-id
